.env
services/*/.env
# The mini's reconcile config normally lives at ~/.coralstack/ollama.env, but
# running the script straight from a checkout would create it here.
host/mac-mini/ollama.env
services/*/*.ovpn
docker-compose.override.yml
data/
*.log
.DS_Store
.claude/

# Python bytecode
__pycache__/
*.pyc

# Homepage initializes these skeleton configs and its logfile at boot; the
# config dir is mounted read-write because it insists on owning them. Our four
# real configs (services/settings/widgets/bookmarks.yaml) stay tracked.
services/homepage/config/kubernetes.yaml
services/homepage/config/docker.yaml
# Same story as the two above: Homepage writes this skeleton into its config dir
# itself and we never configure a Proxmox widget, so it is fully commented out
# and only shows up as noise in `git status`. It contains NO credential — the
# `token:`/`secret:` lines are Homepage's own commented examples, which is easy
# to misread as a live secret.
services/homepage/config/proxmox.yaml
services/homepage/config/custom.css
services/homepage/config/custom.js
services/homepage/config/logs/
