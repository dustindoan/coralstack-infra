{
	email {$ACME_EMAIL}

	# HTTP/3 ENABLED (2026-07-17 reversal): the "hairpin drops UDP/443" probe
	# that justified disabling h3 was later found to have run through a VPN
	# on the admin's Mac — the evidence was tainted, and the admin's phone
	# streamed *better* with h3 on. See docs/NETWORK_TOPOLOGY.md for the
	# clean-instrument verification protocol before touching this again.
}

# Shared TLS config: Let's Encrypt via Cloudflare DNS-01. Using Cloudflare's
# own resolvers (1.1.1.1, 1.0.0.1) for the propagation check — the default
# resolvers (whatever the container's /etc/resolv.conf points at) can be
# slow to see freshly-created TXT records, causing the ACME challenge to
# time out even though the record was successfully published. A longer
# propagation_timeout is belt-and-suspenders for the same problem.
(tls_cloudflare) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
		propagation_delay 30s
		propagation_timeout 5m
	}
}

# ─── Landing page + Matrix delegation ────────────────────────────────────────
# The apex serves the .well-known that tells the Matrix network where this
# community's homeserver actually lives. This is what lets server_name be the
# bare domain (so IDs read @someone:{$BASE_DOMAIN}) while Synapse itself is on
# a subdomain behind the same single 443 forward — no port 8448, no second
# ingress. See docs/MATRIX.md.
{$BASE_DOMAIN} {
	import tls_cloudflare

	# Server-server delegation: which host+port peers should federate with.
	handle /.well-known/matrix/server {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.server": "matrix.{$BASE_DOMAIN}:443"}` 200
	}

	# Client delegation: where clients find the homeserver AND the auth service.
	# The msc2965 block is what points Element (and Element X on mobile) at MAS
	# instead of Synapse for login — without it clients try the legacy password
	# flow, which is disabled, and login fails with an unhelpful error.
	# CORS matters here: this is fetched from the browser, cross-origin.
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver": {"base_url": "https://matrix.{$BASE_DOMAIN}"}, "org.matrix.msc2965.authentication": {"issuer": "https://auth.{$BASE_DOMAIN}/", "account": "https://auth.{$BASE_DOMAIN}/account"}}` 200
	}

	handle {
		respond "CoralStack — you're connected. Services: id, vault, photos, media, ai, chat." 200
	}
}

# ─── Matrix homeserver (Synapse) ─────────────────────────────────────────────
matrix.{$BASE_DOMAIN} {
	import tls_cloudflare

	# THESE THREE PATHS MUST REACH MAS, NOT SYNAPSE. Synapse has delegated login
	# and will not answer them. Order matters — this block has to precede the
	# catch-all reverse_proxy below, and the regex is the exact set MAS's
	# compatibility layer claims. Getting this wrong presents as "login just
	# doesn't work" with nothing obviously broken in either container's logs.
	@mas_compat path_regexp ^/_matrix/client/(.*)/(login|logout|refresh)
	reverse_proxy @mas_compat matrix-auth:8080

	reverse_proxy synapse:8008
}

# ─── Matrix Authentication Service ───────────────────────────────────────────
# Its own hostname because it is a separate OAuth issuer — the issuer URL is
# baked into tokens and into Pocket ID's registered redirect URI, so it cannot
# just be a path under the homeserver.
auth.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy matrix-auth:8080
}

# ─── Element (web client) ────────────────────────────────────────────────────
chat.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy element:80
}

# ─── Pocket ID (identity) ────────────────────────────────────────────────────
id.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy pocket-id:1411
}

# ─── Vaultwarden ─────────────────────────────────────────────────────────────
vault.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy /notifications/hub vaultwarden:3012
	reverse_proxy vaultwarden:80
}

# ─── Ente Photos web app ─────────────────────────────────────────────────────
photos.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy ente-web:3000
}

# ─── Ente museum (API server) ────────────────────────────────────────────────
# Mobile + web clients hit this directly for uploads/downloads. The 50GB body
# size matters here, not on the photos web route — uploads stream through the
# API, not the SPA.
photos-api.{$BASE_DOMAIN} {
	import tls_cloudflare
	request_body {
		max_size 50GB
	}
	reverse_proxy ente-museum:8080
}

# ─── Ente accounts (passkey 2FA flow) ────────────────────────────────────────
photos-accounts.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy ente-web:3001
}

# ─── Ente public albums (share-link recipients) ──────────────────────────────
photos-albums.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy ente-web:3002
}

# ─── Ente S3 storage (MinIO) ─────────────────────────────────────────────────
# Museum hands clients presigned S3 URLs containing the endpoint configured in
# museum.yaml's `s3.<bucket>.endpoint`. Self-hosted clients (mobile, desktop)
# need that to be a publicly reachable URL — the `localhost:3200` + socat-bridge
# trick from Ente's quickstart works only for museum-internal traffic; external
# clients try to PUT to their own machine's loopback and fail. This route
# exposes MinIO via the same Caddy edge so presigned URLs work everywhere.
# See https://help.ente.io/self-hosting/guides/configuring-s3 for upstream's
# framing of the same gotcha.
photos-storage.{$BASE_DOMAIN} {
	import tls_cloudflare
	# Photos + videos can be large; same envelope as the API route for
	# direct PUT uploads.
	request_body {
		max_size 50GB
	}
	# Caddy preserves the Host header by default, which is what AWS SigV4
	# signature validation needs (client signs with photos-storage.<domain>;
	# MinIO recomputes the signature using the same host).
	reverse_proxy ente-minio:3200
}

# ─── Jellyfin ────────────────────────────────────────────────────────────────
media.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy jellyfin:8096
}

# ─── Open WebUI (AI chat via Mac mini Ollama) ────────────────────────────────
ai.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy open-webui:8080
}

# ─── Uptime Kuma (monitoring + public status page) ───────────────────────────
# Public status page + login-gated admin dashboard (Kuma's own auth). This is
# the independent "is it actually down?" page members can check when a cached
# PWA failure state lies to them. See docs/SECURITY_PASS.md for why there's no
# forward_auth in front (per-service auth; the status page is public by design).
status.{$BASE_DOMAIN} {
	import tls_cloudflare
	reverse_proxy uptime-kuma:3001
}
