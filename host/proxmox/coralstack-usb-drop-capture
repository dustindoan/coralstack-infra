#!/bin/bash
# Install on the PROXMOX HOST (coralstack-nuc) as
#   /usr/local/bin/coralstack-usb-drop-capture   (chmod +x)
# Fired by udev when the TerraMaster array (174c:235c) leaves the USB bus.
# The 2026-08-28 outage was diagnosed only after most evidence had scrolled
# away; this makes the next drop self-documenting.
OUT=/var/log/coralstack-usb-drops
mkdir -p "$OUT"
F="$OUT/drop-$(date +%Y%m%d-%H%M%S).log"
{
  echo "=== array left the USB bus at $(date -Is) ==="
  echo "--- uptime ---"; uptime
  echo "--- lsusb -t ---"; lsusb -t 2>/dev/null
  echo "--- enclosure power state ---"
  for d in /sys/bus/usb/devices/*/; do
    v=$(cat "$d/idVendor" 2>/dev/null) || continue
    [ "$v" = "174c" ] || [ "$v" = "0bda" ] || continue
    echo "  $(basename "$d") $v:$(cat "$d/idProduct" 2>/dev/null) control=$(cat "$d/power/control" 2>/dev/null) delay=$(cat "$d/power/autosuspend_delay_ms" 2>/dev/null)"
  done
  echo "--- last 300 kernel lines ---"; dmesg -T | tail -300
} > "$F" 2>&1
logger -t coralstack-usb "TerraMaster array dropped off the bus - forensics: $F"
