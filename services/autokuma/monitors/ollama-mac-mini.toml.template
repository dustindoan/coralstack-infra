# Inference reconcile on the MAC MINI — is the inference host running what the
# repo says? Pushes status=down WITH the reason (version skew against either
# pin, a missing or wrong-revision model, the Login-Item env race, an oMLX
# crash loop, both runtimes holding weights at once), so the alert names the
# problem. See docs/MAC_MINI.md and host/mac-mini/ollama-reconcile.sh.
#
# THE FILENAME AND PUSH TOKEN STAY "ollama-mac-mini" NOW THAT THIS COVERS oMLX
# TOO, and that is deliberate. AutoKuma keys a monitor off this file's name, so
# renaming the file deletes monitor #12 and creates a new one — throwing away
# the heartbeat history that is the primary evidence in three sections of
# MAC_MINI.md, including the 28-day silence that `resend_interval` below exists
# to fix. A slightly stale filename is cheaper than losing the record. Rename
# it in the change that actually retires Ollama, where the push token and the
# mini's ~/.coralstack/ollama.env can be migrated on purpose.
#
# The mini is NOT on the coralstack docker network, so unlike the other push
# monitors its heartbeat arrives via the public status URL and hairpins back
# through the eero. setup.sh prints that URL; it is pasted into the mini's
# ~/.coralstack/ollama.env by hand.
#
# 48h heartbeat against a daily 06:35 check: one missed run is tolerated, two
# is a finding. Same tolerance as the SMART and drift monitors.
type = "push"
# The id from ntfy.toml.template's FILENAME, not its display name.
notification_name_list = ["ntfy"]
name = "Inference reconcile (Mac mini)"
push_token = "${OLLAMA_MINI_PUSH_TOKEN}"
interval = 172800
# Every seventh down beat — roughly weekly against the daily 06:35 check.
#
# THIS FIELD IS WHY THIS MONITOR WENT UNNOTICED FOR 28 DAYS. Measured
# 2026-10-14 from Kuma's DB: monitor #12 has two `important` heartbeats in its
# entire history — up on 2026-09-04, down on 2026-09-17 — then 41 further down
# beats with `important = 0`. Kuma notifies on state CHANGES, and with
# resend_interval = 0 it never speaks again. One ntfy push went out on 09-17
# naming a version skew that cannot self-heal, and the finding was then true
# every single morning in silence.
#
# Weekly, not daily: the finding here is a stale version pin on the one host
# where a bad update costs nothing (MAC_MINI.md's risk inversion). It needs to
# stay visible, not to wake anybody. Weekly is a standing piece of homework.
resend_interval = 7
max_retries = 0
