# SMART check on the apps VM — the TerraMaster (photo blobs + media).
# Pushes status=down WITH the finding text, so an alert names the drive and
# the reason rather than just going red. See docs/HARDWARE_FAILURE.md.
type = "push"
name = "SMART (apps VM)"
push_token = "${SMART_APPS_PUSH_TOKEN}"
interval = 172800
# Re-alert on EVERY down beat. The unit is DOWN BEATS, not minutes — see
# _README.md — so against the daily 06:20 check this is a daily reminder, and
# one every 48h if the checker itself has stopped. A drive in pre-failure is
# the one finding here whose remediation window is actively closing: the data
# has to come off before the disk goes. It nags until someone acts.
# NO-OP ON AUTOKUMA 2.0.0 (push monitors) — set by hand in Kuma's UI
# until >=2.1 stable. Measured 2026-10-15; see _README.md.
resend_interval = 1
max_retries = 0
