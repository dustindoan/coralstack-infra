# SMART check on the Proxmox host — the NUC's M.2, which the apps VM cannot
# see (from inside the VM it's a virtio device with no SMART behind it).
# This one posts via the PUBLIC status URL: the host isn't on the coralstack
# docker network.
type = "push"
name = "SMART (Proxmox host)"
push_token = "${SMART_HOST_PUSH_TOKEN}"
interval = 172800
# Every down beat, same as the apps-VM SMART monitor and for the same reason —
# a closing remediation window. Against the 06:50 systemd timer that is daily.
# This disk matters more than its blast radius suggests: it carries Proxmox and
# both VMs' disks, and (HARDWARE_FAILURE.md) identity and the vault sit on it
# with no redundancy underneath.
# NO-OP ON AUTOKUMA 2.0.0 (push monitors) — set by hand in Kuma's UI
# until >=2.1 stable. Measured 2026-10-15; see _README.md.
resend_interval = 1
max_retries = 0
