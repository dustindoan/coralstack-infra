# Deploy-drift monitor — copy to services/drift/.env on the box.
# Docs: docs/MONITORING.md.

# ─── What "correct" looks like ───────────────────────────────────────────────
# The branch this box is supposed to be running. Anything else is drift — that
# is the whole point: on 2026-08-28 the box sat on `fix/storage-mount-ordering`
# with unpushed commits, and nothing noticed.
DRIFT_EXPECTED_BRANCH=main

# Label used in the alert text, so a notification names the machine.
DRIFT_HOST_LABEL=apps-vm

# ─── Alerting ────────────────────────────────────────────────────────────────
# Uptime Kuma "Push" monitor URL. setup.sh wires this from the token it pins in
# services/autokuma/.env, so the monitor and the pusher agree by construction —
# no copying a generated token out of Kuma's UI.
#
# The check pushes status=down WITH the reason, so drift alerts immediately
# rather than waiting for the heartbeat to lapse. If the container stops
# entirely, the heartbeat lapses and Kuma alerts on that too.
HEALTHCHECK_URL=

# ─── Schedule ────────────────────────────────────────────────────────────────
# Daily. Drift is created by a human at a keyboard, not by a process, so
# polling more often buys nothing and only adds noise. 06:10 puts it just
# ahead of the SMART check at 06:20.
DRIFT_CRON=10 6 * * *
