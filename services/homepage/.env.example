# ─── Homepage widget API keys ────────────────────────────────────────────────
# Homepage's config (services/homepage/config/*.yaml) is COMMITTED, so no secret
# may appear in it. Instead the YAML references {{HOMEPAGE_VAR_NAME}} and
# Homepage substitutes the value from this gitignored file at render time.
#
# Every one of these is optional: leave a key blank and that service still shows
# as a link with an up/down status dot — you just lose the live widget (queue
# counts, download speed, etc).
#
# Read the *arr keys off the box with:
#   for a in sonarr radarr prowlarr; do
#     echo -n "$a: "; grep -oP '(?<=<ApiKey>)[^<]+' ~/coralstack-infra/data/$a/config.xml
#   done
# Public domain for the member-facing links. setup.sh keeps this in sync with
# BASE_DOMAIN in the root .env — don't hand-edit it.
HOMEPAGE_VAR_BASE_DOMAIN=

HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=

# Jellyfin: Dashboard → Advanced → API Keys → add
HOMEPAGE_VAR_JELLYFIN_KEY=

# qBittorrent uses a login, not an API key — the same credentials you set in its
# WebUI (Options → WebUI).
HOMEPAGE_VAR_QBIT_USER=
HOMEPAGE_VAR_QBIT_PASS=
