# Matrix (Synapse + MAS + Element). See docs/MATRIX.md.
#
# setup.sh generates the secrets below. This file is gitignored on the box.

# ─── Postgres ────────────────────────────────────────────────────────────────
# Must be URI-SAFE (hex). MAS takes its database as a URI, so a base64 password
# containing @ / + corrupts the connection string silently. setup.sh generates
# hex for this reason — don't hand-edit in a base64 value.
MATRIX_DB_PASSWORD=

# ─── Synapse ↔ MAS trust ─────────────────────────────────────────────────────
# Synapse no longer handles login; MAS does, and these are how they authenticate
# to each other. Both sides must carry the SAME values — setup.sh renders both
# config files from one .env for exactly that reason.
#
# MATRIX_MAS_CLIENT_SECRET  the OAuth client secret Synapse uses against MAS
# MATRIX_MAS_SHARED_SECRET  the single shared secret Synapse and MAS authenticate with
# MATRIX_MAS_ENCRYPTION     MAS's own at-rest encryption key (must be 64 hex chars)
MATRIX_MAS_CLIENT_SECRET=
MATRIX_MAS_SHARED_SECRET=
MATRIX_MAS_ENCRYPTION=

# ─── Synapse internal ────────────────────────────────────────────────────────
MATRIX_MACAROON_SECRET=
MATRIX_FORM_SECRET=

# ─── Pocket ID OIDC (upstream identity) ──────────────────────────────────────
# Create an OIDC client in Pocket ID, then paste its values here and re-run
# setup.sh to render the MAS config. Until these are set, MAS renders with SSO
# disabled and NOBODY CAN LOG IN — that is deliberate: an open registration
# window on a public vhost is the failure this stack has already had once
# (docs/SECURITY_PASS.md, SEC-2).
#
# Redirect URI to register in Pocket ID:
#   https://auth.<BASE_DOMAIN>/upstream/callback/01HXXXXXXXXXXXXXXXXXXXXXXX
# The trailing ULID is MATRIX_OIDC_PROVIDER_ID below — it must match exactly.
MATRIX_OIDC_CLIENT_ID=
MATRIX_OIDC_CLIENT_SECRET=

# MAS identifies upstream providers by ULID, not by name. Any valid ULID works;
# it just has to stay stable, because it's baked into the redirect URI you
# registered in Pocket ID. Changing it orphans that registration.
MATRIX_OIDC_PROVIDER_ID=01JKMATRIXPOCKETIDPROV01
