# Synapse configuration for CoralStack. RENDERED by setup.sh from this template
# into ${DATA_PATH}/matrix/synapse/homeserver.yaml — edit the template, not the
# rendered copy, or your change dies at the next re-render.
#
# See docs/MATRIX.md for the design and the federation posture.

# ─── Identity ────────────────────────────────────────────────────────────────
# server_name is PERMANENT. It is baked into every user ID and every room this
# server has ever participated in. Changing it does not migrate anything; it
# creates a different server. Chosen deliberately as the bare community domain
# so IDs read @someone:campbellriver.coralstack.org, and so sibling co-ops at
# <other>.coralstack.org are peers rather than subdomains of each other.
#
# Synapse itself is served from matrix.${BASE_DOMAIN}; the apex only serves the
# .well-known delegation pointing here. That is what lets the bare domain be the
# server_name while everything still rides the single 443 forward.
server_name: "${BASE_DOMAIN}"
public_baseurl: "https://matrix.${BASE_DOMAIN}/"
signing_key_path: "/data/${BASE_DOMAIN}.signing.key"

pid_file: /data/homeserver.pid
report_stats: false

listeners:
  - port: 8008
    tls: false
    type: http
    # Caddy terminates TLS and is the only thing that talks to this port.
    x_forwarded: true
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [client, federation]
        compress: false

# ─── Database ────────────────────────────────────────────────────────────────
database:
  name: psycopg2
  args:
    user: synapse
    password: "${MATRIX_DB_PASSWORD}"
    database: synapse
    host: matrix-db
    port: 5432
    cp_min: 5
    cp_max: 10

# ─── Federation ──────────────────────────────────────────────────────────────
# ALLOWLIST, STARTING EMPTY. An empty list means Synapse federates with nobody
# — inbound or outbound — while the server_name and delegation are already
# correct, so enabling a peer later is one line and no migration.
#
# This is the deliberate launch posture: the federation architecture is right
# from day one, but the server is not reachable by the open network before a
# single sibling co-op exists to reach it. Add peers one at a time:
#
#   federation_domain_whitelist:
#     - othercoop.coralstack.org
#
# Removing the key entirely (NOT setting it to a longer list) is what turns on
# open federation with the whole Matrix network. Do that as a considered
# decision, not by deleting a line that looked empty.
federation_domain_whitelist: []

# Rooms can still be created and used locally with federation off; this only
# stops new local rooms defaulting to federated, which would be misleading.
# Leave true so rooms are ready to federate the day a peer is added.
# (Existing rooms cannot be changed from unfederated to federated later.)
# encryption_enabled_by_default_for_room_type below covers the privacy side.

# ─── Registration and login (owned by MAS, not Synapse) ─────────────────────
# With MSC3861 delegation below, Synapse does not handle login at all — MAS
# does. These stay off regardless, as defence in depth: if the delegation were
# ever misconfigured, the failure mode must be "nobody can log in", never "open
# registration on a public vhost".
enable_registration: false
enable_registration_without_verification: false

# NOTE: no registration_shared_secret. That key exists for
# `register_new_matrix_user`, which does not work once MAS owns registration —
# and leaving auth-related keys set alongside delegated auth is a known way to
# get a startup config error. Accounts come from Pocket ID or they don't exist.

macaroon_secret_key: "${MATRIX_MACAROON_SECRET}"
form_secret: "${MATRIX_FORM_SECRET}"

# ─── Delegated auth ──────────────────────────────────────────────────────────
# Hands login to MAS. This is the STABLE config section, not the older
# `experimental_features.msc3861` block that most tutorials still show — that
# form is superseded, and the current docs say to remove it in favour of this.
# The whole handshake is one shared secret; it must match `matrix.secret` in
# mas-config.yaml, which is why setup.sh renders both files from one .env.
matrix_authentication_service:
  enabled: true
  endpoint: "http://matrix-auth:8080"
  secret: "${MATRIX_MAS_SHARED_SECRET}"

# ─── Media ───────────────────────────────────────────────────────────────────
media_store_path: /data/media_store
# Members share photos here as well as in Ente. 50MB covers phone photos and
# short clips without letting the volume grow unboundedly on one paste.
max_upload_size: 50M
url_preview_enabled: false   # URL previews make the server fetch arbitrary
                             # links on users' behalf — an SSRF surface for no
                             # benefit a small co-op needs.

# ─── Privacy defaults ────────────────────────────────────────────────────────
# E2EE on by default for private rooms. Matrix does not do this out of the box;
# for a stack whose whole pitch is that your data is yours, it should.
encryption_enabled_by_default_for_room_type: invite

# Don't leak the member list to the wider network.
allow_public_rooms_without_auth: false
allow_public_rooms_over_federation: false

# ─── Retention / housekeeping ────────────────────────────────────────────────
trusted_key_servers: []          # empty because federation is off; add
                                 # matrix.org here only if you open federation
suppress_key_server_warning: true

log_config: "/data/log.config"
