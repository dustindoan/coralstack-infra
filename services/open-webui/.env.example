# ─── Open WebUI ───────────────────────────────────────────────────────────────
# Generated by setup.sh — do not set manually.
WEBUI_SECRET_KEY=

# ─── Pocket ID OIDC ──────────────────────────────────────────────────────────
# Register Open WebUI in Pocket ID admin UI, then paste the credentials here.
# Redirect URI to register: https://ai.<BASE_DOMAIN>/oauth/oidc/callback
# Login button appears automatically once OAUTH_CLIENT_ID is non-empty.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ─── oMLX on the Mac mini ────────────────────────────────────────────────────
# The API key for the mini's inference server, used as OPENAI_API_KEY.
#
# NOT generated here. `host/mac-mini/install.sh` generates it on the mini with
# `openssl rand -hex 32`, writes it to the untracked ~/.coralstack/omlx.env
# there, and prints it ONCE. Paste that value here by hand — the same last-hop
# manual step as the Uptime Kuma push URL, and for the same reason: the mini is
# not on this VM's docker network, so setup.sh cannot carry a value across.
#
# A mismatch shows up only as a 401 from Open WebUI's model list. See
# docs/MAC_MINI.md.
OMLX_API_KEY=
