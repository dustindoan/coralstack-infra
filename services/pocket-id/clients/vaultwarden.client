# Vaultwarden (OIDCWarden fork) — the password vault. SSO is AUTH only; the
# master passphrase stays an independent vault key, so SSO_ONLY=false.
CLIENT_ID=660f29ac-c5b8-4401-b615-c52c755c426a
CLIENT_NAME=Vaultwarden
CALLBACK_URLS=https://vault.${BASE_DOMAIN}/identity/connect/oidc-signin
PKCE=false
GROUP_RESTRICTED=true
REQUIRES_SERVICE=vaultwarden
TARGET_ENV=services/vaultwarden/.env
ID_KEY=SSO_CLIENT_ID
SECRET_KEY=SSO_CLIENT_SECRET
