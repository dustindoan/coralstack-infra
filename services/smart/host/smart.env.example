# Proxmox-host SMART check config. Install to /etc/coralstack/smart.env.
# This is systemd EnvironmentFile format: KEY=value, no `export`, no quoting
# tricks, no shell expansion.

# The NUC's internal disks. On THIS NUC it is `/dev/sda:sat` — a 2.5" SATA
# SanDisk SDSSDA240G. There is no M.2 or NVMe in this box, despite what an
# earlier version of this file assumed; a wrong default here fails loudly with
# "cannot read SMART data (smartctl rc=2)", which is the check working, not a
# disk problem. Other hardware may want `/dev/nvme0`. Confirm on the box with:
#   lsblk -o NAME,SIZE,TYPE,TRAN,MODEL,SERIAL
#   smartctl --scan-open        # suggests the right -d type for each device
# NOTE: do NOT list the TerraMaster here. It's passed through to the apps VM,
# so the host can't read it and the containerized runner already covers it.
SMART_DEVICES=/dev/sda:sat

SMART_HOST_LABEL=proxmox-host

# Uptime Kuma push monitor URL — see docs/MONITORING.md. The host is NOT on the
# coralstack docker network, so unlike the container this must use the public
# hostname (it hairpins back through eero):
#   https://status.<BASE_DOMAIN>/api/push/<token>
HEALTHCHECK_URL=

# A hot-running M.2 in a NUC wants 65-70. This box's 2.5" SATA SSD idles at
# ~31°C, so 55 is a real threshold here rather than a number that never fires.
SMART_TEMP_WARN=55
SMART_NVME_WEAR_WARN=80
SMART_CRC_WARN=10

SMART_REPORT_PATH=/var/lib/coralstack/smart-report.txt
